@model List<Remittance>
@{ ViewData["Title"] = "Remittance"; }
<div class="page-title"><h3>Payment orders, demand drafts &amp; telegraphic transfers</h3><a class="btn btn-primary" asp-action="Issue">+ Issue instrument</a></div>
<div class="panel"><form class="row g-2 mb-3"><div class="col-md-3"><select name="type" class="form-select" asp-items="Html.GetEnumSelectList<RemittanceType>()"><option value="">All types</option></select></div><div class="col-md-3"><select name="status" class="form-select" asp-items="Html.GetEnumSelectList<RemittanceStatus>()"><option value="">All statuses</option></select></div><div class="col-md-4"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Instrument no / party" /></div><div class="col-md-2"><button class="btn btn-outline-primary">Search</button></div></form>
<table class="table table-sm"><thead><tr><th>Instrument</th><th>Type</th><th>Date</th><th>Applicant</th><th>Beneficiary</th><th class="num">Amount</th><th class="num">Comm+VAT</th><th>Status</th><th style="width:330px"></th></tr></thead><tbody>
@foreach (var r in Model) { <tr><td>@r.InstrumentNo</td><td>@r.Type</td><td>@r.IssueDate.ToString("dd-MMM-yy")</td><td>@r.ApplicantName</td><td>@r.BeneficiaryName <span class="text-muted small">@r.BeneficiaryBank @r.BeneficiaryBranch</span></td><td class="num">@r.Amount.ToString("N2")</td><td class="num">@r.Commission.ToString("N2")</td><td>@Html.Raw(FormHelpers.Badge(r.Status))</td>
<td>@if (r.Status == RemittanceStatus.Issued) { <form method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@r.Id" /><input name="accountNo" class="form-control form-control-sm" placeholder="Credit a/c (blank=cash)" style="max-width:170px" /><button asp-action="Pay" class="btn btn-sm btn-success">Pay</button><button asp-action="Cancel" class="btn btn-sm btn-outline-secondary">Cancel</button><button asp-action="Stop" class="btn btn-sm btn-outline-danger">Stop</button></form> }
 else if (r.Status == RemittanceStatus.Stopped) { <form method="post"><input type="hidden" name="id" value="@r.Id" /><button asp-action="Release" class="btn btn-sm btn-outline-primary">Release stop</button></form> }</td></tr> }
</tbody></table></div>
