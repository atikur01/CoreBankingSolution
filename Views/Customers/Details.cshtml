@model Customer
@{ ViewData["Title"] = Model.Name; var accs = (List<Account>)ViewBag.Accounts; var loans = (List<Loan>)ViewBag.Loans; }
<div class="page-title"><h3>@Model.Name <small class="text-muted">CIF @Model.CifNo</small></h3>
    <div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-primary" asp-controller="Accounts" asp-action="Open" asp-route-cif="@Model.CifNo">Open account</a>
    <a class="btn btn-primary" asp-controller="Loans" asp-action="Apply" asp-route-cif="@Model.CifNo">Loan application</a></div></div>
<div class="row g-3"><div class="col-lg-8"><div class="panel"><div class="row">
    <dl class="col-md-6 kv"><dt>Type</dt><dd>@Model.Type</dd><dt>NID / Passport</dt><dd>@Model.Nid @Model.Passport</dd><dt>Date of birth</dt><dd>@Model.DateOfBirth?.ToString("dd-MMM-yyyy")</dd><dt>Father / Mother</dt><dd>@Model.FatherName / @Model.MotherName</dd><dt>TIN / Trade licence</dt><dd>@Model.Tin @Model.TradeLicense</dd></dl>
    <dl class="col-md-6 kv"><dt>Mobile / Email</dt><dd>@Model.Mobile @Model.Email</dd><dt>Address</dt><dd>@Model.Address</dd><dt>Profession / Sector</dt><dd>@Model.Profession @Model.Sector</dd><dt>Source of funds / Income</dt><dd>@Model.SourceOfFunds @Model.MonthlyIncome.ToString("N0")</dd><dt>Introducer</dt><dd>@Model.IntroducerName @Model.IntroducerAccount</dd></dl></div></div>
<div class="panel"><h5>Accounts</h5><table class="table table-sm"><thead><tr><th>Account</th><th>Title</th><th>Product</th><th class="num">Balance</th><th>Status</th></tr></thead><tbody>
@foreach (var a in accs) { <tr><td><a asp-controller="Accounts" asp-action="Details" asp-route-id="@a.Id">@a.AccountNo</a></td><td>@a.Title</td><td>@a.Product?.Name</td><td class="num">@a.Balance.ToString("N2")</td><td>@Html.Raw(FormHelpers.Badge(a.Status))</td></tr> }
</tbody></table></div>
<div class="panel"><h5>Loans</h5><table class="table table-sm"><thead><tr><th>Loan</th><th>Product</th><th class="num">Principal</th><th class="num">Outstanding</th><th>Class</th><th>Status</th></tr></thead><tbody>
@foreach (var l in loans) { <tr><td><a asp-controller="Loans" asp-action="Details" asp-route-id="@l.Id">@l.LoanNo</a></td><td>@l.Product?.Name</td><td class="num">@l.Principal.ToString("N2")</td><td class="num">@l.OutstandingPrincipal.ToString("N2")</td><td>@l.Classification</td><td>@Html.Raw(FormHelpers.Badge(l.Status))</td></tr> }
</tbody></table></div></div>
<div class="col-lg-4"><div class="panel"><h5>KYC &amp; compliance</h5>
    <p>KYC: @Html.Raw(FormHelpers.Badge(Model.Kyc)) &nbsp; Risk: <b>@Model.Risk</b> @(Model.IsPep ? "· PEP" : "")</p>
    <p class="small">Sanction screening: <b class="@(Model.ScreeningResult?.StartsWith("HIT") == true ? "text-danger" : "text-success")">@Model.ScreeningResult</b></p>
    <p class="small text-muted">Maker: @Model.MadeBy · Checker: @Model.CheckedBy</p>
    <form method="post" asp-action="Rescreen" asp-route-id="@Model.Id" class="mb-2"><button class="btn btn-sm btn-outline-warning">Re-screen now</button></form>
    @if (Model.Kyc != KycStatus.Verified && (User.IsInRole("Administrator") || User.IsInRole("Manager") || User.IsInRole("Supervisor")))
    {
        <form method="post" asp-action="Verify" asp-route-id="@Model.Id"><input name="remarks" class="form-control form-control-sm mb-2" placeholder="Remarks (for rejection)" />
        <button name="approve" value="true" class="btn btn-sm btn-success">Verify KYC</button> <button name="approve" value="false" class="btn btn-sm btn-outline-danger">Reject</button></form>
    }
    </div>
    <div class="panel text-center"><h5>Photograph &amp; signature</h5>
        @if (!string.IsNullOrEmpty(Model.PhotoPath)) { <img class="img-thumbnail mb-2" style="max-height:160px" src="@Url.Action("File", new { id = Model.Id, kind = "photo" })" /> } else { <p class="text-muted">No photo</p> }
        @if (!string.IsNullOrEmpty(Model.SignaturePath)) { <img class="img-thumbnail" style="max-height:80px" src="@Url.Action("File", new { id = Model.Id, kind = "signature" })" /> }
        @if (!string.IsNullOrEmpty(Model.DocumentPath)) { <div class="mt-2"><a target="_blank" href="@Url.Action("File", new { id = Model.Id, kind = "doc" })">View NID / document</a></div> }
    </div></div></div>
