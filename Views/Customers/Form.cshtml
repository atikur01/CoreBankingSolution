@model Customer
@{ ViewData["Title"] = "Customer"; bool isNew = Model.Id == 0; }
<div class="page-title"><h3>@(isNew ? "New customer" : "Edit customer " + Model.CifNo)</h3></div>
<form method="post" enctype="multipart/form-data" class="panel"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3">
    @Html.Field(m => m.Type, 3)
    @Html.Field(m => m.Name, 5)
    @Html.Select(m => m.BranchId, (SelectList)ViewBag.Branches, 4)
    @Html.Field(m => m.FatherName, 4)
    @Html.Field(m => m.MotherName, 4)
    @Html.Field(m => m.SpouseName, 4)
    @Html.Field(m => m.DateOfBirth, 3)
    @Html.Select(m => m.Gender, new[]{"Male","Female","Other"}.Select(x => new SelectListItem(x, x)), 2, "--")
    @Html.Field(m => m.Nid, 3)
    @Html.Field(m => m.Passport, 2)
    @Html.Field(m => m.Tin, 2)
    @Html.Field(m => m.TradeLicense, 3)
    @Html.Field(m => m.Mobile, 3)
    @Html.Field(m => m.Email, 3)
    @Html.Field(m => m.Profession, 3)
    @Html.Field(m => m.Sector, 3)
    @Html.Field(m => m.Address, 6)
    @Html.Field(m => m.PermanentAddress, 6)
    @Html.Field(m => m.SourceOfFunds, 3)
    @Html.Field(m => m.MonthlyIncome, 3)
    @Html.Field(m => m.ContactPerson, 3)
    @Html.Field(m => m.Risk, 3)
    @Html.Field(m => m.IntroducerName, 4)
    @Html.Field(m => m.IntroducerAccount, 4)
    @Html.Field(m => m.IsPep, 2)
    @if (!isNew) { @Html.Field(m => m.IsActive, 2) }
    <div class="col-md-4"><label class="form-label">Photograph (JPG/PNG)</label><input type="file" name="photo" accept=".jpg,.jpeg,.png" class="form-control" /></div>
    <div class="col-md-4"><label class="form-label">Specimen signature</label><input type="file" name="signature" accept=".jpg,.jpeg,.png" class="form-control" /></div>
    <div class="col-md-4"><label class="form-label">NID / documents (PDF/JPG)</label><input type="file" name="document" accept=".pdf,.jpg,.jpeg,.png" class="form-control" /></div>
</div><div class="mt-3"><button class="btn btn-primary">Save</button> <a class="btn btn-light" asp-action="Index">Cancel</a></div></form>
