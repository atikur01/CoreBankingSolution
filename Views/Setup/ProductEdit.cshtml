@model Product
@{ ViewData["Title"] = "Product"; var gls = (SelectList)ViewBag.Gls; }
<div class="page-title"><h3>@(Model.Id == 0 ? "New product" : "Edit product")</h3></div>
<form method="post" class="panel"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3">
    @Html.Field(m => m.Code, 2, hint: "Part of the 13-digit account number")
    @Html.Field(m => m.Name, 6)
    @Html.Field(m => m.Category, 4)
    @Html.Select(m => m.GlAccountId, gls, 4)
    @Html.Select(m => m.InterestGlId, gls, 4, "-- none --")
    @Html.Select(m => m.AccrualGlId, gls, 4, "-- none --")
    @Html.Field(m => m.InterestRate, 3)
    @Html.Field(m => m.OverdraftRate, 3)
    @Html.Field(m => m.PrematureRate, 3)
    @Html.Field(m => m.PayFrequency, 3)
    @Html.Field(m => m.MinOpeningBalance, 3)
    @Html.Field(m => m.MinBalance, 3)
    @Html.Field(m => m.DefaultTermMonths, 3)
    @Html.Field(m => m.ProcessingFeePct, 3)
    @Html.Field(m => m.OpeningFee, 3)
    @Html.Field(m => m.ChequeBookFee, 3, hint: "per 25 leaves")
    @Html.Field(m => m.StopPaymentFee, 3)
    @Html.Field(m => m.ChequeReturnFee, 3)
    @Html.Field(m => m.ClosingFee, 3)
    @Html.Field(m => m.IsInterestBearing, 3)
    @Html.Field(m => m.IsActive, 3)
</div><div class="mt-3"><button class="btn btn-primary">Save</button> <a class="btn btn-light" asp-action="Products">Cancel</a></div></form>
