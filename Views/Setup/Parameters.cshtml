@model List<BankParameter>
@{ ViewData["Title"] = "Bank parameters"; }
<div class="page-title"><h3>Bank parameters</h3></div>
<form method="post" class="panel"><table class="table table-sm"><thead><tr><th>Parameter</th><th style="width:30%">Value</th><th>Description</th></tr></thead><tbody>
@foreach (var p in Model) { <tr><td><code>@p.Key</code></td><td><input class="form-control form-control-sm" name="values[@p.Key]" value="@p.Value" /></td><td class="text-muted small">@p.Description</td></tr> }
</tbody></table><button class="btn btn-primary">Save parameters</button></form>
