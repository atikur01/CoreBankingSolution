@model GlAccount
@{ ViewData["Title"] = "GL account"; }
<div class="page-title"><h3>@(Model.Id == 0 ? "New GL account" : "Edit GL account")</h3></div>
<form method="post" class="panel"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3">
    @Html.Field(m => m.Code, 3, readOnly: Model.Id != 0)
    @Html.Field(m => m.Name, 5)
    @Html.Field(m => m.Type, 4)
    @Html.Select(m => m.ParentId, (SelectList)ViewBag.Parents, 5, "-- top level --")
    @Html.Field(m => m.IsPosting, 3)
    @Html.Field(m => m.IsActive, 3)
    @Html.Field(m => m.Remarks, 12, hint: "e.g. Nostro / Vostro / suspense / memo / intercompany notes")
</div><div class="mt-3"><button class="btn btn-primary">Save</button> <a class="btn btn-light" asp-action="Gl">Cancel</a></div></form>
