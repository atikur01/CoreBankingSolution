@model OpenAccountVm
@{ ViewData["Title"] = "Open account"; }
<div class="page-title"><h3>Open account / FDR / DPS</h3></div>
<form method="post" class="panel"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3">
    @Html.Field(m => m.Cif, 3)
    <div class="col-md-3"><label class="form-label" for="ProductId">Product</label><select id="ProductId" name="ProductId" class="form-select" asp-items="(SelectList)ViewBag.Products" data-cats='@Html.Raw(ViewBag.Cats)'></select></div>
    @Html.Select(m => m.BranchId, (SelectList)ViewBag.Branches, 3)
    @Html.Field(m => m.InitialDeposit, 3, hint: "Cash received; opening fee + VAT are deducted from it")
    @Html.Field(m => m.Title, 6)
    @Html.Field(m => m.Mode, 3)
    @Html.Field(m => m.JointCifs, 3)
    <div class="col-md-3" data-cat="FDR"><label class="form-label">FDR: debit from account no</label><input name="SourceAccountNo" class="form-control" value="@Model.SourceAccountNo" data-account-lookup="#srcInfo" /><div id="srcInfo" class="form-text"></div></div>
    <div class="col-md-3" data-cat="FDR,DPS"><label class="form-label">Proceeds / interest to account no</label><input name="LinkedAccountNo" class="form-control" value="@Model.LinkedAccountNo" data-account-lookup="#lnkInfo" /><div id="lnkInfo" class="form-text"></div></div>
    <div class="col-md-2" data-cat="FDR,DPS">@Html.Field(m => m.TermMonths, 12)</div>
    <div class="col-md-2" data-cat="DPS">@Html.Field(m => m.InstallmentAmount, 12)</div>
    <div class="col-md-2" data-cat="FDR">@Html.Field(m => m.AutoRenew, 12)</div>
    <div class="col-md-2" data-cat="Current">@Html.Field(m => m.OdLimit, 12)</div>
    @Html.Field(m => m.SingleDebitLimit, 3)
    @Html.Field(m => m.DailyDebitLimit, 3)
    @Html.Field(m => m.MonthlyDebitLimit, 3)
    @Html.Field(m => m.PowerOfAttorney, 3)
    <div class="col-12"><h6 class="mt-2">Nominees (individuals only; screened against sanction lists; shares must total 100%)</h6></div>
    @Html.Field(m => m.N1Name, 3) @Html.Field(m => m.N1Relation, 3) @Html.Field(m => m.N1Nid, 3) @Html.Field(m => m.N1Share, 3)
    @Html.Field(m => m.N2Name, 3) @Html.Field(m => m.N2Relation, 3) @Html.Field(m => m.N2Nid, 3) @Html.Field(m => m.N2Share, 3)
</div><div class="mt-3"><button class="btn btn-primary">Create account</button> <a class="btn btn-light" asp-action="Index">Cancel</a></div></form>
