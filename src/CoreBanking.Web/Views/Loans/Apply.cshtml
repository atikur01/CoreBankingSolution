@model LoanApplyVm
@{ ViewData["Title"] = "Loan application"; }
<div class="page-title"><h3>New loan application</h3></div>
<form method="post" class="panel"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3">
 @Html.Field(m => m.Cif, 3)
 @Html.Select(m => m.ProductId, (SelectList)ViewBag.Products, 3)
 @Html.Select(m => m.BranchId, (SelectList)ViewBag.Branches, 3)
 @Html.Field(m => m.SettlementAccountNo, 3)
 @Html.Field(m => m.Principal, 3)
 @Html.Field(m => m.TermMonths, 3)
 @Html.Field(m => m.InterestRate, 3, hint: "Leave 0 to use the approved product rate slab")
 @Html.Field(m => m.Purpose, 3)
 @Html.Field(m => m.Collateral, 6, area: true)
 @Html.Field(m => m.CollateralValue, 3)
 @Html.Field(m => m.Guarantor, 3)
</div><div class="mt-3"><button class="btn btn-primary">Submit application</button></div></form>
