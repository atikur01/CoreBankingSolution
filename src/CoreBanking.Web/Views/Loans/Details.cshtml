@model Loan
@{
    ViewData["Title"] = Model.LoanNo;
    bool checker = User.IsInRole("Administrator") || User.IsInRole("Manager") || User.IsInRole("Supervisor");
    bool ops = checker || User.IsInRole("Officer");
    var sched = Model.Installments.OrderBy(i => i.No).ToList(); var preview = (List<LoanCalculator.Row>?)ViewBag.Preview; var pend = (List<Voucher>)ViewBag.Pending;
}
<div class="page-title"><h3>Loan @Model.LoanNo @Html.Raw(FormHelpers.Badge(Model.Status)) @Html.Raw(FormHelpers.Badge(Model.Classification))</h3><a class="btn btn-light" asp-action="Index">List</a></div>
@if (pend.Count > 0) { <div class="alert alert-warning">Pending vouchers: @foreach (var v in pend) { <a asp-controller="Transactions" asp-action="Details" asp-route-id="@v.Id">@v.VoucherNo (@v.Type)</a> <span>&nbsp;</span> }</div> }
<div class="row g-3"><div class="col-lg-7"><div class="panel"><div class="row"><dl class="col-md-6 kv"><dt>Borrower</dt><dd><a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer?.Name</a> (@Model.Customer?.CifNo)</dd><dt>Product</dt><dd>@Model.Product?.Name</dd><dt>Branch</dt><dd>@Model.Branch?.Name</dd><dt>Settlement account</dt><dd>@Model.SettlementAccount?.AccountNo</dd><dt>Purpose</dt><dd>@Model.Purpose</dd><dt>Security</dt><dd>@Model.Collateral (@Model.CollateralValue.ToString("N0")) @Model.Guarantor</dd></dl>
 <dl class="col-md-6 kv"><dt>Sanctioned amount</dt><dd class="fs-5 fw-bold">@Model.Principal.ToString("N2")</dd><dt>Rate / term</dt><dd>@Model.InterestRate% · @Model.TermMonths months</dd><dt>Outstanding principal</dt><dd>@Model.OutstandingPrincipal.ToString("N2")</dd><dt>Interest receivable</dt><dd>@Model.InterestReceivable.ToString("N2")</dd><dt>Overdue</dt><dd>@Model.OverdueAmount.ToString("N2") (@Model.OverdueDays days)</dd><dt>Provision held</dt><dd>@Model.ProvisionHeld.ToString("N2")</dd><dt>Maker / approver</dt><dd>@Model.MadeBy / @Model.ApprovedBy</dd></dl></div></div>
 <div class="panel"><h5>@(sched.Count > 0 ? "Repayment schedule" : "Schedule preview")</h5><table class="table table-sm"><thead><tr><th>#</th><th>Due</th><th class="num">Principal</th><th class="num">Interest</th><th class="num">Installment</th><th class="num">Paid</th><th>Status</th></tr></thead><tbody>
 @foreach (var i in sched) { <tr class="@(i.Status == InstallmentStatus.Due && i.DueDate < DateTime.Today ? "table-warning" : "")"><td>@i.No</td><td>@i.DueDate.ToString("dd-MMM-yyyy")</td><td class="num">@i.PrincipalDue.ToString("N2")</td><td class="num">@i.InterestDue.ToString("N2")</td><td class="num">@i.Total.ToString("N2")</td><td class="num">@((i.PrincipalPaid + i.InterestPaid).ToString("N2"))</td><td>@i.Status</td></tr> }
 @if (preview != null) { foreach (var r in preview) { <tr class="text-muted"><td>@r.No</td><td>@r.Due.ToString("dd-MMM-yyyy")</td><td class="num">@r.Principal.ToString("N2")</td><td class="num">@r.Interest.ToString("N2")</td><td class="num">@((r.Principal + r.Interest).ToString("N2"))</td><td></td><td>preview</td></tr> } }
 </tbody></table></div></div>
<div class="col-lg-5">
 @if (Model.Status == LoanStatus.Applied && checker) { <div class="panel"><h5>Approval</h5><form method="post" asp-action="Decide" asp-route-id="@Model.Id"><input name="reason" class="form-control mb-2" placeholder="Reason (required for rejection)" /><button name="approve" value="true" class="btn btn-success">Approve</button> <button name="approve" value="false" class="btn btn-outline-danger">Reject</button></form></div> }
 @if (Model.Status == LoanStatus.Approved && ops) { <div class="panel"><h5>Disbursement</h5><p class="small">Creates a voucher: Dr loan GL / Cr settlement account (net of @Model.Product?.ProcessingFeePct% processing fee + VAT).</p><form method="post" asp-action="Disburse" asp-route-id="@Model.Id"><button class="btn btn-primary">Create disbursement voucher</button></form></div> }
 @if (Model.Status == LoanStatus.Disbursed) { <div class="panel"><h5>Repayment</h5><p class="small">Total remaining dues: <b>@(((decimal)ViewBag.Payoff).ToString("N2"))</b> (full payoff). Allocation: oldest installment first, interest then principal.</p>
  <form method="post" asp-action="Repay" asp-route-id="@Model.Id" class="row g-2"><div class="col-6"><input name="amount" type="number" step="0.01" class="form-control" placeholder="Amount" required /></div><div class="col-6"><input name="sourceAccountNo" class="form-control" placeholder="Debit account (blank = cash)" /></div><div class="col-12"><button class="btn btn-primary">Create repayment voucher</button></div></form></div> }
 @if (!string.IsNullOrEmpty(Model.RejectReason)) { <div class="alert alert-danger">Rejected: @Model.RejectReason</div> }
</div></div>
