@model Branch
@{ ViewData["Title"] = "Branch"; }
<div class="page-title"><h3>@(Model.Id == 0 ? "New branch" : "Edit branch")</h3></div>
<form method="post" class="panel"><div class="row g-3">
    @Html.Field(m => m.Code, 3, readOnly: Model.Id != 0)
    @Html.Field(m => m.Name, 5)
    @Html.Select(m => m.Layer, new[]{"HO","Division","Region","Cluster","Branch","SubBranch","Booth","Outlet"}.Select(x => new SelectListItem(x, x)), 4)
    @Html.Select(m => m.ParentId, (SelectList)ViewBag.Parents, 4, "-- none --")
    @Html.Field(m => m.RoutingNumber, 4)
    @Html.Field(m => m.Phone, 4)
    @Html.Field(m => m.Address, 12)
    @Html.Field(m => m.CostCenter, 4)
    @Html.Field(m => m.ProfitCenter, 4)
    @Html.Field(m => m.IsActive, 2)
    @Html.Field(m => m.DayOpen, 2)
</div><div class="mt-3"><button class="btn btn-primary">Save</button> <a class="btn btn-light" asp-action="Branches">Cancel</a></div></form>
