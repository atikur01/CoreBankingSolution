@{ ViewData["Title"] = "Roles"; }
<div class="page-title"><h3>Roles &amp; permissions</h3></div>
<div class="panel"><table class="table table-sm"><thead><tr><th>Function</th><th>Teller</th><th>Officer</th><th>Supervisor</th><th>Manager</th><th>Administrator</th></tr></thead><tbody>
@{ var rows = new (string, string)[] {
 ("View customers, accounts, loans, reports", "YYYYY"), ("Cash deposit / withdrawal / transfer (maker)", "YYYYY"), ("Create customers, open accounts, loans, GL journal, remittance", "NYYYY"),
 ("Authorize / reject vouchers (checker, standard amounts)", "NNYYY"), ("Authorize Level-2 vouchers (high value / back-value)", "NNNYY"), ("Verify KYC, approve loans, freeze/activate accounts, EOD", "NNYYY"),
 ("Setup: branches, products, rates, chart of accounts, parameters", "NNNYY"), ("User, role & audit-trail administration", "NNNNY") }; }
@foreach (var (f, p) in rows) { <tr><td>@f</td>@foreach (var c in p) { <td>@(c == 'Y' ? "✔" : "")</td> }</tr> }
</tbody></table>
<p class="small text-muted mb-0">Maker-checker is enforced independently of roles: nobody can authorize an entry they created. Per-user maker limits (single debit/credit, inter-branch), allowed terminal IP and operating hours are set on each user.</p></div>
